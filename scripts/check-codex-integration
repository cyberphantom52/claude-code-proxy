#!/bin/sh
# Offline synthetic acceptance only: no Claude CLI, real auth, or live benchmarks.
set -eu
if [ "$#" -ne 0 ]; then
    printf '%s\n' 'Usage: scripts/check-codex-integration (offline mocks only)' >&2
    exit 2
fi
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
isolated=$(mktemp -d)
trap 'rm -rf "$isolated"' EXIT HUP INT TERM

# Keep the installed toolchain/dependency cache, not inherited proxy/auth settings.
env -i PATH="$PATH" HOME="$isolated" \
    CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" \
    RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}" \
    CCP_CONFIG_DIR="$isolated/config" \
    XDG_STATE_HOME="$isolated/state" \
    LOCALAPPDATA="$isolated/local" \
    NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost \
    /bin/sh -eu -c '
        cd "$1"
        cargo test --offline --lib retry::tests
        cargo test --offline --test server models_endpoint
        cargo test --offline --test discovery
        # Real proxy TCP ingress and mocked upstream WebSockets, including tools.
        cargo test --offline --test codex_agent_continuation
        cargo test --offline --test smoke_cutover smoke_codex_http_server_compaction_replays_native_history -- --exact
        cargo test --offline --test smoke_cutover smoke_codex_http_compaction_failure_preserves_portable_summary -- --exact
        cargo test --offline --test smoke_cutover context_window_error_requests_compaction
        cargo test --offline --test codex_compact_effort
        # These two are internal contracts, not an actual CLI /model or /fast UI.
        cargo test --offline --lib interactive_fast_mode_changes_tier_not_the_selected_family_model
        cargo test --offline --lib replay_clears_on_model_change
        printf "%s\n" "Offline mock acceptance passed; actual Claude CLI UI and live quality/latency/cache remain unverified."
    ' sh "$root"
